{
  "protocol": 1,
  "transports": ["ble", "usb_serial", "wifi_http"],
  "framing": "one UTF-8 JSON object per line, max 1023 bytes per command; flat objects only",
  "common_fields": {"type": "command name, required", "request_id": "integer echoed in the response", "protocol": "optional, sender's protocol version", "source": "optional, sender name"},
  "no_auth_required": ["hello", "ping", "auth"],
  "commands": {
    "hello": {"response": ["protocol", "firmware", "device", "platform", "auth_required"]},
    "ping": {},
    "auth": {"pin": "string, 6 digits from the device Info screen"},
    "get_state": {"response": ["emotion", "energy", "happiness", "curiosity", "attention", "affection", "stress", "sleepiness", "hunger", "fun", "health", "pet_status", "screen", "battery", "charging", "volume", "brightness", "sound", "mic", "unread", "time", "weather", "temp"]},
    "emotion": {"value": ["neutral", "happy", "very_happy", "sad", "angry", "annoyed", "surprised", "curious", "thinking", "sleepy", "sleeping", "waking_up", "scared", "affection", "bored", "attentive", "confused", "excited", "mischievous", "shy", "proud", "dizzy", "yawning", "cold", "hot", "dreamy", "focused", "winking", "smug", "skeptical", "guilty", "embarrassed", "hopeful", "lonely", "grateful", "jealous", "determined", "terrified", "disgusted", "hungry", "starstruck", "laughing", "crying", "relieved", "sneaky", "nostalgic", "playful", "amazed", "exhausted", "suspicious"], "hold_ms": "optional integer, default 3000"},
    "action": {"value": ["feed", "pet", "play", "sleep", "wake"]},
    "set_stat": {"name": ["happiness", "energy", "curiosity", "attention", "affection", "stress", "sleepiness", "hunger", "fun", "health"], "value": "0..100"},
    "setting": {"name": {"brightness": "5..100", "volume": "0..100", "sound": "bool", "mic": "bool", "mic_sensitivity": "10..100", "touch_sensitivity": "10..100", "anim_speed": "25..250", "blink_rate": "0..250", "sleep_after": "15..7200 s", "power_save": "bool", "wifi": "bool", "ble": "bool", "cat_emotions": "bool", "cat_interactions": "bool", "cat_system": "bool", "cat_games": "bool", "ai_voice_consent": "bool", "tz_minutes": "-720..840", "latitude": "-90..90", "longitude": "-180..180", "personality": ["playful", "calm", "grumpy", "shy"], "ai_url": "string up to 95 bytes"}, "value": "see name"},
    "get_settings": {},
    "notify": {"title": "string, required", "text": "string", "icon": ["bell", "message", "mail", "phone", "calendar", "warning"], "source": "string", "time": "UTC epoch seconds"},
    "notifications": {"value": ["clear", "read_all", "omitted: counts only"], "response": ["count", "unread"]},
    "screen": {"value": ["face", "menu", "pet", "analog_clock", "digital_clock", "timer", "stopwatch", "notifications", "settings", "diagnostics", "games", "info", "tictactoe", "reaction", "guess", "pet_game", "maze", "orbit", "snake", "simon", "weather"]},
    "play_sound": {"value": "pack name, e.g. emotions/happy"},
    "weather": {"value": ["clear", "clouds", "rain", "snow", "storm", "fog", "wind"], "temp": "degrees C"},
    "set_time": {"epoch": "UTC seconds, required", "tz_minutes": "optional"},
    "wifi_config": {"ssid": "string up to 32 bytes, required", "password": "string up to 64 bytes"},
    "chat": {"text": "string, required; answered on the device with emotion and caption"},
    "ai_listen": {"note": "requires ai_voice_consent, records up to 4 s and sends to the configured gateway"},
    "gesture": {"value": ["tap", "double_tap", "long_press", "swipe_left", "swipe_right", "swipe_up", "swipe_down"], "x": "optional", "y": "optional"},
    "sim_event": {"value": ["shake", "jerk", "face_down", "lift", "loud", "clap", "voice"]},
    "diag": {"response": ["platform", "fps", "free_heap", "free_psram", "touch_ok", "imu_ok", "pmic_ok", "codec_ok", "mic_ok", "ble", "wifi", "ip", "mac", "mic_db", "ax", "ay", "az", "battery_mv", "sounds", "sounds_played"]},
    "factory_reset": {"value": "confirm"}
  },
  "errors": ["bad_json", "too_long", "no_type", "unknown_type", "bad_value", "auth_required", "auth_failed", "auth_locked", "protocol_mismatch", "no_consent"]
}
